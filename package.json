{
    "name": "thinkt-web-lite",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "THINKT_API_TOKEN=$(thinkt server token 2>/dev/null) vite",
        "build": "tsc && vite build",
        "build:fast": "tsc && vite build",
        "preview": "vite preview",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "typecheck": "tsc --noEmit",
        "ci:check": "npm run lint && npm run typecheck && npm run build"
    },
    "dependencies": {
        "@wethinkt/ts-thinkt": "0.1.19",
        "eslint": "^10.0.2"
    },
    "author": "Neomantra Corp",
    "license": "MIT",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "typescript": "^5.0.0",
        "typescript-eslint": "^8.56.1",
        "vite": "^5.0.0"
    }
}
